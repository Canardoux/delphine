{
        "name": "delphine",
        "displayName": "Delphine",
        "description": "Custom editor + preview webview for Delphine forms",
        "version": "0.0.1",
        "publisher": "canardoux",
        "license": "GPL-3.0-only",
        "repository": {
                "type": "git",
                "url": "https://github.com/Canardoux/delphine"
        },
        "engines": {
                "vscode": "^1.90.0"
        },
        "categories": [
                "Other"
        ],
        "main": "./out/extension/extension.js",
        "activationEvents": [
                "onCommand:delphine.preview",
                "onCommand:delphine.previewBrowser",
                "onCommand:delphine.openEditor",
                "onCommand:delphine.openSource",
                "onCommand:delphine.runApp",
                "onCommand:delphine.newProject",
                "onCommand:delphine.newForm",
                "onCommand:delphine.newFrame",
                "onCommand:delphine.newApp",
                "onCustomEditor:delphine.customEditor"
        ],
        "contributes": {
                "languages": [
                        {
                                "id": "delphine-dform",
                                "aliases": [
                                        "Delphine Form",
                                        "dform"
                                ],
                                "extensions": [
                                        ".dform"
                                ],
                                "configuration": "./language-configuration.json"
                        }
                ],
                "grammars": [
                        {
                                "language": "delphine-dform",
                                "scopeName": "source.delphine-dform",
                                "path": "./syntaxes/delphine-dform.tmLanguage.json"
                        }
                ],
                "commands": [
                        {
                                "command": "delphine.newProject",
                                "title": "New Project",
                                "category": "Delphine",
                                "icon": "$(new-folder)"
                        },
                        {
                                "command": "delphine.newForm",
                                "title": "New Form",
                                "category": "Delphine",
                                "icon": "$(new-file)"
                        },
                        {
                                "command": "delphine.openSource",
                                "title": "Open Form/Frame Source",
                                "category": "Delphine"
                        },
                        {
                                "command": "delphine.openEditor",
                                "title": "Open Editor",
                                "category": "Delphine",
                                "icon": "$(edit)"
                        },
                        {
                                "command": "delphine.preview",
                                "title": "Preview",
                                "category": "Delphine",
                                "icon": "$(preview)"
                        },
                        {
                                "command": "delphine.previewBrowser",
                                "title": "Preview in Browser",
                                "category": "Delphine",
                                "icon": "$(globe)"
                        },
                        {
                                "command": "delphine.newApp",
                                "title": "New App",
                                "category": "Delphine",
                                "icon": "$(rocket)"
                        },
                        {
                                "command": "delphine.runApp",
                                "title": "Run App",
                                "category": "Delphine",
                                "icon": "$(play)"
                        },
                        {
                                "command": "delphine.newFrame",
                                "title": "New Frame",
                                "category": "Delphine",
                                "icon": "$(new-file)"
                        },
                        {
                                "command": "delphine.openDesigner",
                                "title": "Delphine: Open Designer"
                        }
                ],
                "customEditors": [
                        {
                                "viewType": "delphine.customEditor",
                                "displayName": "Delphine Custom Editor",
                                "selector": [
                                        {
                                                "filenamePattern": "*.dform"
                                        }
                                ],
                                "priority": "option"
                        }
                ],
                "menus": {
                        "editor/title": [
                                {
                                        "when": "resourceExtname == .dform",
                                        "command": "delphine.openEditor",
                                        "group": "navigation@1"
                                },
                                {
                                        "when": "resourceExtname == .dform",
                                        "command": "delphine.preview",
                                        "group": "navigation@2"
                                },
                                {
                                        "when": "resourceExtname == .dform",
                                        "command": "delphine.previewBrowser",
                                        "group": "navigation@3"
                                },
                                {
                                        "when": "resourceFilename == application.ts",
                                        "command": "delphine.runApp",
                                        "group": "navigation@4"
                                }
                        ],
                        "webview/context": [
                                {
                                        "when": "webviewId == 'delphinePreview'",
                                        "command": "delphine.openEditor"
                                }
                        ],
                        "view/title": [
                                {
                                        "command": "delphine.newApp",
                                        "when": "view == delphineTree",
                                        "group": "navigation@1"
                                },
                                {
                                        "command": "delphine.newForm",
                                        "when": "view == delphineTree",
                                        "group": "navigation@2"
                                },
                                {
                                        "command": "delphine.newFrame",
                                        "when": "view == delphineTree",
                                        "group": "navigation@3"
                                },
                                {
                                        "command": "delphine.runApp",
                                        "when": "view == delphineTree",
                                        "group": "navigation@4"
                                }
                        ],
                        "view/item/context": [
                                {
                                        "command": "delphine.newProject",
                                        "when": "view == delphineTree && viewItem == project",
                                        "group": "create@0"
                                },
                                {
                                        "command": "delphine.newApp",
                                        "when": "view == delphineTree && viewItem == project",
                                        "group": "create@1"
                                },
                                {
                                        "command": "delphine.newForm",
                                        "when": "view == delphineTree && (viewItem == project || viewItem == formsFolder)",
                                        "group": "create@2"
                                },
                                {
                                        "command": "delphine.newFrame",
                                        "when": "view == delphineTree && (viewItem == project || viewItem == framesFolder)",
                                        "group": "create@3"
                                },
                                {
                                        "command": "delphine.openEditor",
                                        "when": "view == delphineTree && (viewItem == form || viewItem == frame || viewItem == dformFile || viewItem == tsFile)",
                                        "group": "open@1"
                                },
                                {
                                        "command": "delphine.openSource",
                                        "when": "view == delphineTree && (viewItem == form || viewItem == frame || viewItem == dformFile || viewItem == tsFile)",
                                        "group": "open@2"
                                },
                                {
                                        "command": "delphine.preview",
                                        "when": "view == delphineTree && (viewItem == form || viewItem == frame || viewItem == dformFile || viewItem == tsFile)",
                                        "group": "open@3"
                                },
                                {
                                        "command": "delphine.previewBrowser",
                                        "when": "view == delphineTree && (viewItem == form || viewItem == frame || viewItem == dformFile || viewItem == tsFile)",
                                        "group": "open@4"
                                },
                                {
                                        "command": "delphine.runApp",
                                        "when": "view == delphineTree && (viewItem == project || viewItem == applicationFile || viewItem == formsFolder || viewItem == form || viewItem == dformFile || viewItem == tsFile)",
                                        "group": "navigation@1"
                                }
                        ]
                },
                "viewsContainers": {
                        "activitybar": [
                                {
                                        "id": "delphine",
                                        "title": "Delphine",
                                        "icon": "images/del1.svg"
                                }
                        ]
                },
                "views": {
                        "delphine": [
                                {
                                        "id": "delphineTree",
                                        "name": "Delphine"
                                }
                        ]
                }
        },
        "keywords": [
                "grapes",
                "grapesjs",
                "wysiwyg",
                "web",
                "template",
                "editor",
                "newsletter",
                "site",
                "builder"
        ],
        "scripts": {
                "vscode:prepublish": "npm run compile",
                "compile": "tsc -p tsconfig.extension.json",
                "watch": "tsc -watch -p ./",
                "lint": "eslint .",
                "test": "node ./out/test/runTest.js"
        },
        "devDependencies": {
                "@types/jsdom": "^28.0.3",
                "@types/node": "^20.0.0",
                "@types/vscode": "^1.90.0",
                "@typescript-eslint/eslint-plugin": "^8.0.0",
                "@typescript-eslint/parser": "^8.0.0",
                "@vitest/browser-playwright": "^4.0.0",
                "eslint": "^9.0.0",
                "playwright": "^1.52.0",
                "svelte": "^5.55.0",
                "typescript": "^5.4.0",
                "vitest": "^4.0.0"
        },
        "dependencies": {
                "grapesjs": "^0.22.14",
                "jsdom": "^29.1.1",
                "lit": "^3.3.3",
                "madge": "^8.0.0",
                "parse5": "^8.0.0",
                "prettier": "^3.8.1",
                "toto": "^0.0.2",
                "vue": "^3.5.29"
        }
}
