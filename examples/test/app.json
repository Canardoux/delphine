{
        "name": "test",
        "mainForm": "MainForm",
        "forms": [
                {
                        "name": "MainForm",
                        "url": "./src/forms/MainForm.dform"
                },
                {
                        "name": "Riri",
                        "url": "./src/forms/Riri.dform"
                }
        ],
        "frames": [
                {
                        "className": "HelloFrame",
                        "type": "frame",
                        "url": "./src/frames/HelloFrame.dform",
                        "tagName": "hello-frame"
                },
                {
                        "name": "LitFrame",
                        "className": "TLitFrame",
                        "type": "lit",
                        "url": "./src/frames/LitFrame.ts",
                        "tagName": "lit-frame",
                        "module": "./dist/frames/LitFrame.js",

                        "props": [
                                { "name": "msg", "kind": "string", "default": "Caption" },
                                { "name": "numberClicked", "kind": "number", "default": 0 }
                        ],

                        "events": [{ "name": "MessageChanged" }]
                }
        ],
        "ui": {
                "theme": "win98",
                "density": "normal",
                "fontScale": 1
        },
        "palettes": ["standard", "lit"],
        "plugins": [
                {
                        "id": "hello-vue",
                        "type": "vue",
                        "factory": "./plugins/hello-vue/index.ts"
                },
                {
                        "id": "hello-svelte",
                        "type": "svelte",
                        "factory": "./plugins/hello-svelte/index.ts"
                }
        ]
}
