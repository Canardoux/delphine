<delphine version="1.0" class="MainForm" name="MainForm"></delphine>

<style>
* {
        box-sizing: border-box;
}

#button-a {
        color: rgb(255, 0, 255);
}

#button-b {
        color: rgb(255, 128, 128);
        width: 100px;
        height: 100px;
        background-image: unset;
        background-repeat: unset;
        background-position-x: unset;
        background-position-y: unset;
        background-attachment: unset;
        background-size: unset;
}

#button1 {
        color: rgb(255, 0, 0);
}

#buttonx {
        color: rgb(255, 0, 0);
        width: 180px;
        height: 100px;
}

#iqo9k {
        margin-top: 0px;
        margin-right: 0px;
        margin-bottom: 0px;
        margin-left: 0px;
        width: 82px;
        height: 113px;
        display: none;
}

#MainForm {
        background-color: rgb(207, 196, 196);
}

#mypanel {
        color: rgb(1, 1, 1);
        background-color: rgb(222, 232, 18);
        width: 360px;
        height: 146px;
}

body {
        margin: 0;
}

body {
        margin-top: 0px;
        margin-right: 0px;
        margin-bottom: 0px;
        margin-left: 0px;
}
</style>

<template>
<div
        data-delphine-component="TForm"
        data-delphine-props='{
            "onclick": "mainForm_onclick",
            "name": "MainForm"
          }'
        id="MainForm"
        data-delphine-name="MainForm"
        data-delphine-oncreate="onMyCreate"
        data-delphine-onshown="onMyShown"
        data-delphine-onclick="mainForm_onclick"
        data-delphine-caption="Caption"
>
        <label
                data-delphine-component="TCheckBox"
                data-delphine-name="chk3"
                data-delphine-caption="Ririxxx"
                data-delphine-onclick="chk_onclick"
                id="idhc"
                data-delphine-checked="false"
        >
                <input
                        data-delphine-component="TCheckBox"
                        data-delphine-name="TCheckBox"
                        type="checkbox"
                        data-delphine-part="chkBox"
                        id="zzz"
                        data-delphine-onclick=""
                        data-delphine-caption="Caption"
                />
                <span
                        data-delphine-component="TCheckBox"
                        data-delphine-name="TCheckBox"
                        data-delphine-part="caption"
                        id="ifg2"
                        data-delphine-onclick=""
                        data-delphine-caption="Caption"
                >
                        Ririxxx
                </span>
        </label>
        <div
                data-delphine-component="TPanel"
                id="mypanel1"
                data-delphine-name="myPanel1"
                data-delphine-onclick=""
                data-delphine-caption="Caption"
        >
                <button
                        data-delphine-component="TButton"
                        id="button-a"
                        data-delphine-caption="Riri"
                        data-delphine-name="button-a"
                        data-delphine-onclick="buttona_onclick"
                >
                        Riri
                </button>
                <button
                        data-delphine-component="TButton"
                        id="button-b"
                        data-delphine-caption="push Riri"
                        data-delphine-name="button-b"
                        data-delphine-onclick="buttonb_onclick"
                >
                        push Riri
                </button>
                <label
                        data-delphine-component="TLabel"
                        data-delphine-name="Label"
                        data-delphine-onclick="label_onclick"
                        data-delphine-caption="Label"
                        id="iim1z"
                >
                        Label
                </label>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="buttonZ"
                        id="xyz"
                        data-delphine-onclick="label_onclick"
                        data-delphine-caption="Caption"
                >
                        Caption
                </button>
                <label
                        data-delphine-component="TCheckBox"
                        data-delphine-name="checkBox"
                        data-delphine-onclick="chk_onclick"
                        data-delphine-caption="Caption"
                >
                        <input type="checkbox" data-delphine-part="chkBox" checked="checked" />
                        <span data-delphine-part="caption">Caption</span>
                </label>
        </div>
        <button
                data-delphine-component="TButton"
                id="button1"
                data-delphine-name="button1"
                data-delphine-props='{
            
            "onclick": "button1_onclick",
            "caption": "Delphine button1 caption",
            "name": "button1"
          }'
                data-delphine-caption="Button1 Caption"
                data-delphine-onclick="button1_onclick"
        >
                Button1 Caption
        </button>
        <button
                data-delphine-component="TButton"
                id="buttonx"
                data-delphine-caption="Delphine buttonx caption"
                data-delphine-name="buttonx"
                data-delphine-onclick="label_onclick"
        >
                Delphine buttonx caption
        </button>
        <h1 id="igfu" data-delphine-onclick="" data-delphine-caption="Caption">Bonjour</h1>
        <div
                data-delphine-component="THostFrame"
                id="myframeplugin"
                data-delphine-name="myframeplugin"
                data-delphine-message="Bonjour depuis Delphine!!!"
                data-delphine-props='{
            "message": "Hello depuis Delphine",
            "count": 3,
          }'
                data-delphine-frame="hello-frame"
                data-delphine-onframeevent="myframe_onFrameEvent"
                data-delphine-onclick=""
                data-delphine-caption="Caption"
        >
                MY-FRAME-PLUGIN
        </div>
        <div
                data-delphine-component="TPanel"
                id="mypanel"
                data-delphine-name="myPanel"
                data-delphine-onclick="myPanel_onclick"
                data-delphine-caption="Caption"
        >
                <button
                        data-delphine-component="TButton"
                        data-delphine-caption="sub-button1"
                        data-delphine-name="sub-button1"
                        data-delphine-onclick="subButton1_onclick"
                        id="igqcr"
                >
                        sub-button1
                </button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="button"
                        id="iqo9k"
                        data-delphine-caption=""
                        data-delphine-onclick=""
                ></button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-caption="sub-button2"
                        data-delphine-name="sub-button2"
                        data-delphine-onclick="subButton1_onclick"
                        id="i8hlw"
                >
                        sub-button2
                </button>
        </div>
</div>
</template>
