                        data-delphine-onclick="buttonb_onclick"
                        data-delphine-delphinedisplayname=""
                        class="delphine-control delphine-button"
                >
                        push Riri
                </button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="Button"
                        data-delphine-onclick="Button_onclick"
                        data-delphine-caption="Caption"
                        class="delphine-control delphine-button"
                >
                        Caption
                </button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="Button1"
                        data-delphine-onclick="Button1_onclick"
                        data-delphine-caption="Caption"
                        class="delphine-control delphine-button"
                >
                        Caption
                </button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="Button2"
                        data-delphine-onclick=""
                        data-delphine-caption="Caption"
                        class="delphine-control delphine-button"
                >
                        Caption
                </button>
        </div>
        <button
                data-delphine-component="TButton"
