                data-delphine-caption="Win95 Design"
                class="delphine-control delphine-button"
        >
                Win95 Design
        </button>
        <h1 id="igfu" data-delphine-onclick="" data-delphine-caption="Caption" data-delphine-name="Component1">Bonjour</h1>
        <div
