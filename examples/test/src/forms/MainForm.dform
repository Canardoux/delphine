<delphine version="1.0" class="MainForm" name="MainForm"></delphine>

<style>
* {
        box-sizing: border-box;
}

#button-a {
        color: rgb(255, 0, 255);
}

#button-b {
        color: rgb(255, 128, 128);
        width: 100px;
        height: 100px;
        background-image: unset;
        background-repeat: unset;
        background-position-x: unset;
        background-position-y: unset;
        background-attachment: unset;
        background-size: unset;
}

#button1 {
        color: rgb(255, 0, 0);
}

#buttonx {
        color: rgb(255, 0, 0);
        width: 180px;
        height: 100px;
}

#iqo9k {
        margin-top: 0px;
        margin-right: 0px;
        margin-bottom: 0px;
        margin-left: 0px;
        width: 82px;
        height: 113px;
}

#MainForm {
        background-color: rgb(207, 196, 196);
}

#mypanel {
        color: rgb(1, 1, 1);
        background-color: rgb(222, 232, 18);
        width: 360px;
        height: 146px;
}

body {
        margin: 0;
}

body {
        margin-top: 0px;
        margin-right: 0px;
        margin-bottom: 0px;
        margin-left: 0px;
}
</style>

<template>
<div
        data-delphine-component="TForm"
        data-delphine-props='{
            "onclick": "mainForm_onclick",
            "name": "MainForm"
          }'
        id="MainForm"
        data-delphine-name="MainForm"
        data-delphine-oncreate="onMyCreate"
        data-delphine-onshown="onMyShown"
        data-delphine-onclick="mainForm_onclick"
>
        Hello from AutoRunDelphiMode : MainForm
        <div id="i7jm">
                <input
                        type="checkbox"
                        id="scales"
                        name="scales"
                        checked
                        data-delphine-component="TCheckBox"
                        data-delphine-name="chk1"
                        data-delphine-checked="true"
                        data-delphine-caption="VraimentJe suis d'accord"
                />
                <label for="scales">Écailles</label>
        </div>
        <div id="itf51">
                <input
                        type="checkbox"
                        id="horns"
                        name="horns"
                        data-delphine-component="TCheckBox"
                        data-delphine-name="chk2"
                        data-delphine-checked="false"
                        data-delphine-caption="Vraiment!"
                />
                <label for="horns">Cornes</label>
        </div>
        <div data-delphine-component="TPanel" id="mypanel1" data-delphine-name="myPanel1">
                <button
                        data-delphine-component="TButton"
                        id="button-a"
                        data-delphine-caption="Riri"
                        data-delphine-name="button-a"
                        data-delphine-onclick="buttona_onclick"
                >
                        Riri
                </button><button
                        data-delphine-component="TButton"
                        id="button-b"
                        data-delphine-caption="push Riri"
                        data-delphine-name="button-b"
                        data-delphine-onclick="buttonb_onclick"
                >
                        push Riri
                </button>
        </div>
        <button
                data-delphine-component="TButton"
                id="button1"
                data-delphine-name="button1"
                data-delphine-props='{
            
            "onclick": "button1_onclick",
            "caption": "Delphine button1 caption",
            "name": "button1"
          }'
                data-delphine-caption="Button Caption"
        >
                Button Caption
        </button>
        <button
                data-delphine-component="TButton"
                id="buttonx"
                data-delphine-caption="Delphine buttonx caption"
                data-delphine-name="buttonx"
        >
                Delphine buttonx caption
        </button>
        <h1 id="igfu">
                Mon titreABC
                <br />
        </h1>
        <div
                data-delphine-component="THostFrame"
                id="myframeplugin"
                data-delphine-name="myframeplugin"
                data-delphine-message="Bonjour depuis Delphine!!!"
                data-delphine-props='{
            "message": "Hello depuis Delphine",
            "count": 3,
          }'
                data-delphine-frame="hello-frame"
                data-delphine-onframeevent="myframe_onFrameEvent"
        >
                MY-FRAME-PLUGIN
        </div>
        <div data-delphine-component="TPanel" id="mypanel" data-delphine-name="myPanel">
                <button
                        data-delphine-component="TButton"
                        data-delphine-caption="sub-button1"
                        data-delphine-name="sub-button1"
                        data-delphine-onclick="subButton1_onclick"
                        id="igqcr"
                >
                        sub-button1
                </button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-name="button"
                        id="iqo9k"
                        data-delphine-caption=""
                ></button>
                <button
                        data-delphine-component="TButton"
                        data-delphine-caption="sub-button2"
                        data-delphine-name="sub-button2"
                        data-delphine-onclick="subButton1_onclick"
                        id="i8hlw"
                >
                        sub-button2
                </button>
        </div>
</div>
</template>
