<delphine version="1.0" class="MainForm" name="MainForm"></delphine>

<style>
.delphine-button {
        color: rgb(255, 128, 128);
        height: 40px;
}

.delphine-control.delphine-button {
        color: rgb(255, 128, 128);
        height: 40px;
}

* {
        box-sizing: border-box;
}

#button-a {
        color: rgb(255, 0, 255);
}

#button-b {
        color: rgb(255, 128, 128);
        width: 100px;
        height: 100px;
        background-image: unset;
        background-repeat: unset;
        background-position-x: unset;
        background-position-y: unset;
        background-attachment: unset;
        background-size: unset;
}

#button1 {
        color: rgb(255, 0, 0);
}

#buttonx {
        color: rgb(255, 0, 0);
        width: 180px;
        height: 100px;
}

#MainForm {
        background-color: rgb(207, 196, 196);
        color: rgb(255, 128, 128);
}

#mypanel {
        color: rgb(1, 1, 1);
        background-color: rgb(222, 232, 18);
        width: 360px;
        height: 146px;
}

body {
        margin: 0;
}

body {
        margin-top: 0px;
        margin-right: 0px;
        margin-bottom: 0px;
        margin-left: 0px;
}
</style>

<template>
<div
