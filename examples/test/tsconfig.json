{
        "compilerOptions": {
                "target": "ES2020",
                "module": "ESNext",
                "moduleResolution": "Bundler",
                "strict": true,
                "jsx": "preserve",
                "sourceMap": true,
                "types": ["vite/client"],
                "baseUrl": ".",
                "paths": {
                        "@vcl": ["../../src/vcl/index.ts"],
                        "@vcl/*": ["../../src/vcl/*"]
                }
        },
        "include": ["**/*.ts", "**/*.d.ts", "**/*.svelte"]
}
