{
        "name": "test",
        "mainForm": "MainForm",
        "forms": [
                {
                        "name": "MainForm",
                        "frame": "MainFrame",
                        "autoCreate": true
                },
                {
                        "name": "RiriForm",
                        "frame": "RiriFrame",
                        "autoCreate": true
                }
        ],
        "frames": [
                {
                        "name": "MyLitFrame",
                        "className": "TMyLitFrame",
                        "type": "lit",
                        "url": "./src/frames/TMyLitFrame.ts",
                        "tagName": "mylit-frame",
                        "module": "./dist/frames/TMyLitFrame.js",
                        "props": [],
                        "events": []
                },
                {
                        "name": "SubFrame",
                        "className": "TSubFrame",
                        "type": "lit",
                        "url": "./src/frames/subframe.ts",
                        "tagName": "sub-frame",
                        "module": "./dist/frames/subframe.js",
                        "props": [],
                        "events": []
                },
                {
                        "name": "MainFrame",
                        "className": "MainFrame",
                        "type": "lit",
                        "url": "./src/frames/MainFrame.ts",
                        "tagName": "main-frame",
                        "module": "./dist/frames/MainFrame.js",
                        "props": [],
                        "events": []
                },
                {
                        "name": "RiriFrame",
                        "className": "RiriFrame",
                        "type": "lit",
                        "url": "./src/frames/RiriFrame.ts",
                        "tagName": "riri-frame",
                        "module": "./dist/frames/RiriFrame.js",
                        "props": [],
                        "events": []
                }
        ],
        "ui": {
                "theme": "win98",
                "density": "normal",
                "fontScale": 1
        },
        "palettes": ["standard", "additional"],
        "plugins": [
                {
                        "id": "hello-vue",
                        "type": "vue",
                        "factory": "./plugins/hello-vue/index.ts"
                },
                {
                        "id": "hello-svelte",
                        "type": "svelte",
                        "factory": "./plugins/hello-svelte/index.ts"
                }
        ]
}
