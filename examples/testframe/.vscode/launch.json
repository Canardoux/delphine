{
        "version": "0.2.0",
        "configurations": [
                {
                        "name": "Debug Delphine App in Chrome",
                        "type": "pwa-chrome",
                        "request": "launch",
                        "url": "http://127.0.0.1:5173/app.html?app=AutoRunDelphiMode",
                        "webRoot": "${workspaceFolder}/examples/test"
                },
                {
                        "name": "Debug Delphine Preview in Chrome",
                        "type": "pwa-chrome",
                        "request": "launch",
                        "url": "http://127.0.0.1:5173/preview.html?app=MainApp&form=AutoRunDelphiMode",
                        "webRoot": "${workspaceFolder}/examples/test"
                }
        ]
}
